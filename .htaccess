# firstduefiretruckparty.com – static site (replaces WordPress)

# Serve index.html first (WordPress used index.php)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the non-www domain
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://firstduefiretruckparty.com/$1 [R=301,L]

# Old "-old-2023" copies of pages -> the new pages
RewriteRule ^services/([a-z0-9-]+)-old-2023/?$ /services/$1/ [R=301,L]
RewriteRule ^home-old-2023/?$ / [R=301,L]
RewriteRule ^about-us-old-2023/?$ /about-us/ [R=301,L]

# Pages that no longer exist -> closest page
# Removed fundraiser posts (Lahaina wildfire) -> 410 Gone so Google drops them from search
RewriteRule ^(help-rebuild-lives-support-lahaina-wildfire-victims|lahaina-wildfire-logistical-support)(/.*)?$ - [G,L]
RewriteRule ^category/fundraise(/.*)?$ - [G,L]
RewriteRule ^elementor-hf/.*$ /services/ [R=301,L]
RewriteRule ^(category|tag|author)/.*$ / [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap|elementor-hf-sitemap)\.xml$ /sitemap.xml [R=301,L]

# Add a trailing slash to page URLs (e.g. /about-us -> /about-us/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5})$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Block access to WordPress leftovers and private files
<IfModule mod_rewrite.c>
RewriteRule ^(wp-admin|wp-includes)(/.*)?$ - [R=404,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-config\.php)$ - [R=404,L]
</IfModule>
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<FilesMatch "^\.htaccess\.wp-backup">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|py|sh|log|bak|sql)$">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
