# Staging copy at /staging/ on the DirectAdmin host
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /staging/404.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<FilesMatch "\.(md|yml|yaml)$">
  Require all denied
</FilesMatch>
